# music-wiki 환경 변수 예시.
# music-wiki 환경 변수 예시.
# 이 파일을 복사해 .env 를 만들고 실제 값을 채우세요:   cp .env.example .env
# .env 는 .gitignore 로 커밋에서 제외됩니다(비밀값 보호).

# ── 외부 음악 DB (LP/CD 인벤토리 보강 · M2 LP 모듈) ─────────────────
# Discogs 개인 액세스 토큰.  discogs.com → Settings → Developers → "Generate new token"
# 물리 음반(LP/CD)·클래식 식별(카탈로그번호 매칭)에 사용. 지금 채워야 하는 값.
DISCOGS_TOKEN=

# MusicBrainz API User-Agent 에 넣을 연락처(이메일 또는 URL). MB API 예절상 필요.
MUSICBRAINZ_CONTACT=neotango7614@gmail.com

# ── 로컬 LLM (LM Studio, Phase 2: 장르 분류 + 앨범 해설) ────────────
# LM Studio 의 OpenAI 호환 서버 주소. 기본 로컬 1234 포트.
LLM_BASE_URL=http://localhost:1234/v1
# LM Studio 에 로드한 모델 id (예: qwen3-14b, gemma-3-12b, qwen3-30b-a3b 등).
LLM_MODEL=qwen3-14b
