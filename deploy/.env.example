# music-wiki 스택 설정 (cp .env.example .env 후 수정)
NEO4J_PASSWORD=musicwiki
NEO4J_HEAP=1G
NEO4J_PAGECACHE=512M
WEB_PORT=8765
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# 데이터 경로 (ser8 이관 시 여기만 바꾸면 됨)
VAULT_DIR=${HOME}/music-wiki-vault
INVENTORY_DIR=../inventory

# ── mp3 경로: 두 값의 역할이 다르다 (헷갈리기 쉬우니 주의) ──────────
# MUSIC_DIR = 이 기계에서 mp3가 실제로 보이는 경로. 컨테이너 /data/music 로 마운트된다.
#   · ser8 단독 운영(외장 SSD 직결): /mnt/music/media
#   · 개발 PC(원본 직접):            /mnt/win/memory/음악
MUSIC_DIR=/mnt/music/media
# MUSIC_SRC = DB의 abs_path 에 기록된 원본 루트(스캔 당시 경로). 앱이 이 접두사를
#   /data/music 으로 치환해 재생하므로, 재스캔하지 않는 한 절대 바꾸지 말 것.
MUSIC_SRC=/mnt/win/memory/음악

# 외부 접속(Tailscale) — profile remote 로 기동할 때만 필요
TS_AUTHKEY=
TS_HOSTNAME=musicwiki
