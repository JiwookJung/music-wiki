# music-wiki 스택 설정 (cp .env.example .env 후 수정)
NEO4J_PASSWORD=musicwiki
NEO4J_HEAP=1G
NEO4J_PAGECACHE=512M
WEB_PORT=8765
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# 데이터 경로 (ser8 이관 시 여기만 바꾸면 됨)
VAULT_DIR=${HOME}/music-wiki-vault
INVENTORY_DIR=../inventory
MUSIC_DIR=/mnt/win/memory/음악

# 외부 접속(Tailscale) — profile remote 로 기동할 때만 필요
TS_AUTHKEY=
TS_HOSTNAME=musicwiki

# ── ser8 단독 운영(외장 SSD 직결) ────────────────────────────────
# 재생할 mp3 폴더 (컨테이너 /data/music 로 마운트)
MUSIC_DIR=/mnt/music/media
# DB abs_path 에 기록된 원본 루트 — 재스캔 전에는 바꾸지 말 것(고정)
MUSIC_SRC=/mnt/win/memory/음악
