FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir \
      fastapi "uvicorn[standard]" markdown neo4j openpyxl jinja2 \
      sentence-transformers --extra-index-url https://download.pytorch.org/whl/cpu
COPY webapp/ /app/webapp/
COPY src/ /app/src/
COPY scripts/ /app/scripts/
ENV PYTHONPATH=/app/src
EXPOSE 8765
CMD ["uvicorn", "webapp.app:app", "--host", "0.0.0.0", "--port", "8765", "--app-dir", "/app"]
